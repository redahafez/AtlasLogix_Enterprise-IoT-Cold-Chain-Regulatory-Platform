# Django Settings
SECRET_KEY=change-this-insecure-key-to-a-secure-random-secret-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx

# Database Configuration (PostgreSQL)
POSTGRES_DB=atlaslogix
POSTGRES_USER=atlaslogix_user
POSTGRES_PASSWORD=atlaslogix_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration (Channels & Caching)
REDIS_URL=redis://redis:6379/0

# Next.js Client Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
